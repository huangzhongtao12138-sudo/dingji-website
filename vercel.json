{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/site-assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/public/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/cases/bixiangju",
      "destination": "/cases/bixiangju.html"
    },
    {
      "source": "/cases/shidingxiang",
      "destination": "/cases/shidingxiang.html"
    },
    {
      "source": "/cases/xiangyuan",
      "destination": "/cases/xiangyuan.html"
    },
    {
      "source": "/cases/grid-coffee",
      "destination": "/cases/grid-coffee.html"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "https://www.djzhuangshi.com/",
      "statusCode": 301
    },
    {
      "source": "/dingji-homepage-preview.html",
      "destination": "https://www.djzhuangshi.com/",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "djzhuangshi.com"
        }
      ],
      "destination": "https://www.djzhuangshi.com/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "djzhuangshi.com"
        }
      ],
      "destination": "https://www.djzhuangshi.com/:path*",
      "statusCode": 301
    }
  ]
}
